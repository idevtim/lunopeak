{
  "name": "lunopeak",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "description": "Your AI dev environment, at a glance.",
  "license": "MIT",
  "author": "Timothy Murphy",
  "homepage": "https://lunopeak.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idevtim/lunopeak.git"
  },
  "bugs": "https://github.com/idevtim/lunopeak/issues",
  "scripts": {
    "dev": "vite",
    "demo": "cross-env VITE_DEMO_MODE=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "icons": "bash scripts/build-icons.sh",
    "icons:mac": "bash scripts/embed-glass-icon.sh --preview",
    "tauri:dev": "tauri dev",
    "tauri:demo": "cross-env VITE_DEMO_MODE=1 LUNOPEAK_DEMO=1 tauri dev",
    "win:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-windows.ps1",
    "win:demo": "cross-env VITE_DEMO_MODE=1 LUNOPEAK_DEMO=1 powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-windows.ps1",
    "mac:dev": "tauri dev",
    "nix:dev": "bash scripts/dev-linux.sh",
    "tauri:build": "tauri build",
    "dist:mac": "bash scripts/build-dmg.sh",
    "dist:win": "node scripts/dist-windows.mjs",
    "dist:nix": "bash scripts/dist-linux.sh",
    "dist:nix:docker": "bash scripts/docker-build-linux.sh",
    "build:mac": "bash scripts/build-dmg.sh",
    "build:win": "node scripts/dist-windows.mjs",
    "build:linux": "bash scripts/dist-linux.sh",
    "build:linux:docker": "bash scripts/docker-build-linux.sh",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-autostart": "^2.0.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-fs": "^2.0.3",
    "@tauri-apps/plugin-notification": "^2.0.1",
    "@tauri-apps/plugin-os": "^2.0.1",
    "@tauri-apps/plugin-shell": "^2.0.1",
    "@tauri-apps/plugin-updater": "^2.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.13.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.0.10"
  },
  "allowScripts": {
    "fsevents": false
  }
}
