# Apple Developer Account (required for code signing + notarization)
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

# Codesigning identity name as it appears in `security find-identity -v -p codesigning`.
# Defaults to "Developer ID Application: Tim Murphy (${APPLE_TEAM_ID})" if unset.
APPLE_SIGNING_IDENTITY=

# Password for the Tauri updater signing key at ~/.tauri/lunopeak.key.
# Required to produce the .app.tar.gz.sig the auto-updater uses. Leave blank
# only if the key was generated without a password (`signer generate ... --ci`).
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
