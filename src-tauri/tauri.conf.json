{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LunoPeak",
  "version": "2.1.0",
  "identifier": "com.lunopeak.app",
  "build": {
    "beforeDevCommand": "cross-env TAURI_DEV_STRICT=1 npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "LunoPeak",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com https://api.x.ai http://localhost:11434 http://127.0.0.1:11434"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "copyright": "Copyright © 2026 LunoPeak",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Your AI dev environment, at a glance.",
    "longDescription": "LunoPeak is a cross-platform desktop dashboard that gives developers a real-time, unified view of their AI-assisted development environment.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/lunopeak.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/lunopeak.desktop"
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/idevtim/lunopeak/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1QkQ5OEJGODU1NTA2REIKUldUYkJsV0Z2NWk5ZGY2RzlEc3BvU2NyN0VrSmhVS0RYcU1YT0dDU3RHTkRpMHlNMnY4eVQ3bHMK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
