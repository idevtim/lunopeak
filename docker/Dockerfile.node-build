# syntax=docker/dockerfile:1
#
# Minimal image for building lunopeak-node on Linux, used by
# scripts/docker-build-linux.sh to build the aarch64 node natively on an
# Apple Silicon host (`--platform linux/arm64`). The main build image is pinned
# to amd64 and only builds the node for its own arch, so without this the
# release had no lunopeak-node-linux-aarch64.tar.gz and install-node.sh failed
# with a 404 on ARM Linux (2.6.0 / 2.6.1).
#
# No platform pin: the caller picks it. The node is built static against musl,
# so the Ubuntu base only supplies the toolchain, not a glibc floor.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      musl-tools \
      build-essential \
      curl \
      ca-certificates \
      file \
      # rookie's build script runs `git rev-parse` and panics if git is absent
      git \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"
RUN rustup target add aarch64-unknown-linux-musl x86_64-unknown-linux-musl

RUN git config --global --add safe.directory /app

WORKDIR /app
CMD ["bash"]
